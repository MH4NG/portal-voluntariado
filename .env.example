# Chave da Google Maps JavaScript API (habilite também a Geocoding API).
# Sem chave, o portal exibe a lista acessível de ações no lugar do mapa.
VITE_GOOGLE_MAPS_API_KEY=

# Map ID (necessário para AdvancedMarker). Crie em Google Cloud > Map Management.
# Se vazio, usa o DEMO_MAP_ID do Google (apenas para desenvolvimento).
VITE_GOOGLE_MAPS_MAP_ID=
